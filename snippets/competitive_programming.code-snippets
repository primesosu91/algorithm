            "    // S側頂点取得: source_side(始点) -> 現在の残余グラフで始点から到達可能な頂点",
            "    vector<int> source_side(int source) const {",
            "        vector<bool> reachable = min_cut(source);",
            "",
            "        vector<int> result;",
            "",
